# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

# --- PostgreSQL (administracion: reconstruir, datos, pruebas SQL) ---
LAB_DB_HOST=localhost
LAB_DB_PORT=5432
LAB_DB_NAME=lab_banco
LAB_DB_USER=postgres
LAB_DB_PASSWORD=

# --- Rol de login del backend (lo crea src/reconstruir.py) ---
LAB_API_PASSWORD=

# --- Backend ---
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# Cadena aleatoria de 32+ caracteres para firmar JWT
JWT_SECRET=
# Cadena aleatoria para derivar el hash de numeros de tarjeta (HMAC)
CARD_PEPPER=

# --- Datos de prueba sinteticos (npm run seed) ---
SEED_PASSWORD=
SEED_PIN=
